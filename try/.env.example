# Internal backend API used only by Next.js server routes.
KAAM_BACKEND_API_URL=http://localhost:5083/api

# OpenID Connect / OAuth server configuration.
KAAM_AUTH_SERVER=http://localhost:5083
KAAM_CLIENT_ID=kaam-next.js
KAAM_CLIENT_SECRET=secret
KAAM_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Public backend origin used by browser-visible media and the login request.
NEXT_PUBLIC_KAAM_BACKEND_ORIGIN=http://localhost:5083
